# frozen_string_literal: true

require "rake/extensiontask"

root = __dir__
gemspec = Gem::Specification.load(File.join(root, "klenod-plugin-css.gemspec"))

Rake::ExtensionTask.new("native", gemspec) do |extension|
  extension.lib_dir = "lib/klenod/plugin/css"
  extension.ext_dir = "ext/native"
  extension.source_pattern = "{Cargo.toml,Cargo.lock,src/**/*.rs}"
  extension.cross_compile = ENV.key?("RUBY_TARGET")
  extension.cross_platform = [ENV["RUBY_TARGET"]].compact
  extension.cross_compiling do |native_spec|
    native_spec.dependencies.reject! { it.name == "rb_sys" }
    native_spec.files.reject! { it.end_with?(".rs") || it.match?(/Cargo\.(toml|lock)$/) || it.end_with?("extconf.rb") }
    requirements = [gemspec.required_ruby_version, native_spec.required_ruby_version].flat_map(&:requirements).map { |operator, version| "#{operator} #{version}" }
    native_spec.required_ruby_version = Gem::Requirement.new(*requirements)
  end
end

# Ensure the generic gem task packages the cross-compiled extension instead of
# rebuilding it with the host Ruby's linker configuration.
if ENV.key?("RUBY_TARGET")
  task :native unless Rake::Task.task_defined?(:native)
  task gem: :cross
end

task default: :compile
