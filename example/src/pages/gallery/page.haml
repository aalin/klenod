:ruby
  Figure = import("../../components/Figure.haml")
  Coffee = import("./coffee.jpg?width=360,720&format=jpeg")
  SailingBoat = import("./sailing-boat.jpg?width=360,720&format=jpeg")
  Vegetables = import("./vegetables.jpg?width=360,720&format=jpeg")

  def initialize(name:, tagline:, image:, params: {})
    @name = name
    @tagline = tagline
  end

%article.gallery
  %header.hero
    %p.kicker Klenod images
    %h1 Image gallery
    %p= @tagline
  %section.grid
    %div.card
      %Figure{ image: Coffee, alt: "Coffee cup on a table", caption: "Coffee imported from a routed Haml page." }
    %div.card
      %Figure{ image: SailingBoat, alt: "Sailing boat on open water", caption: "A sailing image with generated JPEG widths." }
    %div.card
      %Figure{ image: Vegetables, alt: "Vegetables arranged for cooking", caption: "Vegetables rendered through the shared Figure component." }
