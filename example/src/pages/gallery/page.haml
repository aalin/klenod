:ruby
  Figure = import("../../components/Figure.haml")
  Coffee = import("./coffee.jpg?width=360,720&format=jpeg")
  SailingBoat = import("./sailing-boat.jpg?width=360,720&format=jpeg")
  Vegetables = import("./vegetables.jpg?width=360,720&format=jpeg")

  def initialize(name:, tagline:, image:, params: {})
    @name = name
    @tagline = tagline
    @items = [
      {
        image: Coffee,
        alt: "Coffee cup on a table",
        caption: "Coffee imported from a routed Haml page."
      },
      {
        image: SailingBoat,
        alt: "Sailing boat on open water",
        caption: "A sailing image with generated JPEG widths."
      },
      {
        image: Vegetables,
        alt: "Vegetables arranged for cooking",
        caption: "Vegetables rendered through the shared Figure component."
      }
    ]
  end

%article.gallery
  %header.hero
    %p.kicker Klenod images
    %h1 Image gallery
    %p= @tagline
  %section.grid
    = @items.map do |item|
      %div.card
        %Figure{ image: item.fetch(:image), alt: item.fetch(:alt), caption: item.fetch(:caption) }
