#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup" if File.exist?(File.expand_path("../Gemfile", __dir__))
require "fileutils"

require "klenod"
require_relative "../lib/tools/build_logger"
require_relative "../lib/web_config"

config = Example::WebConfig.build_config
output = config.output_path
assets_dir = config.assets_path
logger = Example::BuildLogger.new
build_start = Process.clock_gettime(Process::CLOCK_MONOTONIC)

FileUtils.mkdir_p(File.dirname(output))

context = config.context

logger.step("Collecting bundle")
bundle = context.graph.bundle(entrypoints: config.entrypoints)
logger.detail("entrypoints: #{config.entrypoints.join(", ")}")
logger.detail("modules: #{bundle.modules.length}")
logger.detail("assets: #{context.assets.length}")
Example::BuildLogging.log_asset_counts(context, logger)

if ENV["VERBOSE_ASSETS"]
  logger.step("Asset manifest")
  Example::BuildLogging.log_assets(context, logger)
end

if assets_dir
  logger.step("Materializing assets")
  context.write_assets(assets_dir) do |event, asset, path|
    Example::BuildLogging.log_asset_write_event(logger, event, asset, path)
  end
end

logger.step("Writing bundle")
File.binwrite(output, Klenod::Runtime::BundleFormat.dump(bundle))
logger.written(output)
logger.completed(Process.clock_gettime(Process::CLOCK_MONOTONIC) - build_start)
