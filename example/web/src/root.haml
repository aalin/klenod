:ruby
  THEMES = %w[light dark].freeze
  Favicon = import("./favicon.svg")

  def document_theme
    theme = @@request.cookies.fetch(Example::Framework::THEME_COOKIE, nil)
    theme if THEMES.include?(theme)
  end

%html{ lang: I18n.lang, "data-theme" => document_theme }
  %head
    %meta{ name: "viewport", content: "width=device-width, initial-scale=1" }
    %title= I18n.t(:document, :title)
    = $stylesheet_references.map do |reference|
      %link{ rel: "stylesheet", href: reference.asset.url, "data-index" => reference.index }
    = $javascript_references.map do |reference|
      %script{ type: "module", src: reference.asset.url, "data-index" => reference.index }
    %link(rel="icon" type="image/svg" href=Favicon)
  %body
    = $children
