:ruby
  PopoverButton = import("/components/PopoverButton.haml")
  Themes = [
    { value: "system", label: "OS Default", icon: "\u{1F313}" },
    { value: "light", label: "Light", icon: "\u{2600}\u{FE0F}" },
    { value: "dark", label: "Dark", icon: "\u{1F319}" }
  ].freeze

:ruby
  current_theme = request.cookies.fetch(Example::THEME_COOKIE, "system")
  current_theme = "system" unless Themes.any? { |theme| theme[:value] == current_theme }
  return_to = request.path
  current = Themes.find { |theme| theme[:value] == current_theme }

%PopoverButton{
  id: "theme-menu",
  anchor: "theme-switcher",
  title: "Choose theme",
  popover_class: ClassNames[:popover]
}
  %span.icon(slot="button" aria-hidden="true")= current[:icon]

  %form{ method: "post", action: "/api/theme" }
    %input{ type: "hidden", name: "_method", value: "put" }
    %input{ type: "hidden", name: "return_to", value: return_to }
    = Themes.map do |theme|
      - selected = theme[:value] == current_theme
      %button{
        type: "submit",
        name: "value",
        value: theme[:value],
        "aria-current" => selected && "true"
      }
        %span.icon(aria-hidden="true")= theme[:icon]
        %span= theme[:label]
