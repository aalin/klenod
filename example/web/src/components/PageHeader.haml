:ruby
  Logo = import("./logo.svg")

  def initialize(kicker: nil, title:, summary: nil, children: nil)
    @kicker = kicker
    @title = title
    @summary = summary
  end

%header
  %img.logo{ src: Logo.src, width: Logo.width, height: Logo.height, alt: "" }
  .content
    = if @kicker
      %p.kicker= @kicker
    %h1= @title
    = if @summary
      %p.summary= @summary
