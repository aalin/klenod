:ruby
  Icon = import("./language-solid-full.svg")
  Languages = [
    { locale: "en", label: "English", code: "EN" },
    { locale: "sv", label: "Svenska", code: "SV" }
  ]

  def initialize(children: nil)
  end

:ruby
  current_path = request.canonical_path || request.path
  current_locale = request.route_locale || "en"
.switcher
  %button(type="button" popovertarget="language-menu" popovertargetaction="toggle" title="Choose language")
    %img.icon{ src: Icon.src, width: Icon.width, height: Icon.height, alt: "" }
    %span.code= current_locale.upcase
  #language-menu.popover{ popover: "auto" }
    = Languages.map do |language|
      - selected = language[:locale] == current_locale
      %a{
        href: current_path,
        hreflang: language[:locale],
        "aria-current" => selected && "true"
      }
        %span= language[:label]
        %code= language[:code]
