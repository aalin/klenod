:ruby
  PopoverButton = import("/components/PopoverButton.haml")
  Languages = [
    { locale: "en", label: "English", code: "EN" },
    { locale: "sv", label: "Svenska", code: "SV" }
  ]

:ruby
  current_path = request.canonical_path || request.path
  current_locale = request.route_locale || "en"

%PopoverButton{
  id: "language-menu",
  anchor: "language-switcher",
  title: "Choose language",
  button_class: ClassNames[:button],
  popover_class: ClassNames[:popover],
  button: [
    Example::H[:span, class: ClassNames[:icon], :"aria-hidden" => true],
    Example::H[:span, current_locale.upcase, class: ClassNames[:code]]
  ]
}
  = Languages.map do |language|
    - selected = language[:locale] == current_locale
    %a{
      href: current_path,
      hreflang: language[:locale],
      "aria-current" => selected && "true"
    }
      %span= language[:label]
      %code= language[:code]
