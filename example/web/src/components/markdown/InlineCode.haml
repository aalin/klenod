:ruby
  require "pathname"
  require "set"
  require "strscan"
  require "uri"

  Object.const_set(:Rouge, Module.new) unless Object.const_defined?(:Rouge)

  require "rouge/version"
  require "rouge/util"
  require "rouge/text_analyzer"
  require "rouge/token"
  require "rouge/lexer"
  require "rouge/regex_lexer"
  require "rouge/template_lexer"
  require "rouge/lexers/plain_text"
  require "rouge/lexers/xml"
  require "rouge/lexers/css"
  require "rouge/lexers/html"
  require "rouge/lexers/javascript"
  require "rouge/lexers/jsx"
  require "rouge/lexers/typescript"
  require "rouge/lexers/tsx"
  require "rouge/lexers/erb"
  require "rouge/lexers/markdown"
  require "rouge/lexers/sass"
  require "rouge/lexers/ruby"
  require "rouge/lexers/haml"

  SUPPORTED_LEXERS = {
    "ruby" => ::Rouge::Lexer.find("ruby"),
    "haml" => ::Rouge::Lexer.find("haml"),
    "css" => ::Rouge::Lexer.find("css"),
    "js" => ::Rouge::Lexer.find("javascript"),
    "javascript" => ::Rouge::Lexer.find("javascript"),
    "jsx" => ::Rouge::Lexer.find("jsx"),
    "ts" => ::Rouge::Lexer.find("typescript"),
    "typescript" => ::Rouge::Lexer.find("typescript"),
    "tsx" => ::Rouge::Lexer.find("tsx")
  }.freeze
  HIGHLIGHT_CACHE = {}

  def highlighted_children(children, language)
    lexer = SUPPORTED_LEXERS[language]
    return children unless lexer

    source = children.text_content
    cache_key = [language, source]
    cached = HIGHLIGHT_CACHE[cache_key]
    return cached if cached

    HIGHLIGHT_CACHE[cache_key] = lexer.lex(source).map do |token, value|
      token_class = token.shortname&.to_sym
      next value unless token_class && ClassNames.key?(token_class)

      Example::H[:span, value, class: ClassNames[token_class]]
    end.freeze
  end

  def language_from(class_name)
    class_name.to_s.split.find { |name| name.start_with?("language-") }&.delete_prefix("language-")
  end

- class_name = $class
- language = language_from(class_name)

%code{ class: class_name }
  = highlighted_children($children, language)
