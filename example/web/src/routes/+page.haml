:ruby
  Button = import("../components/Button.haml")
  PageHeader = import("../components/PageHeader.haml")
  ImportExample = [
    'Card = import("./Card.haml")',
    'Styles = import("./Card.css")',
    'Logo = import("./logo.svg")',
    'Config = import("./config.toml")'
  ].join("\n").freeze

%title= I18n.t(:header, :title)

%article
  .hero
    %PageHeader{
      kicker: I18n.t(:header, :kicker),
      title: I18n.t(:header, :title),
      summary: I18n.t(:header, :summary)
    }
    .actions
      %Button{ href: "/docs/getting-started" }= I18n.t(:actions, :get_started)
      %a.secondary-action{ href: "/docs" }= I18n.t(:actions, :docs)

  %section.story
    .graph-intro
      .section-copy
        %h2= I18n.t(:graph, :title)
        %p= I18n.t(:graph, :first)
        %p= I18n.t(:graph, :second)
      :markdown
        ```ruby
        Card = import("./Card.haml")
        Styles = import("./Card.css")
        Logo = import("./logo.svg")
        Config = import("./config.toml"
        ```
    .modes
      .mode
        %p.label= I18n.t(:development, :label)
        %h3= I18n.t(:development, :title)
        %p= I18n.t(:development, :body)
      .mode
        %p.label= I18n.t(:production, :label)
        %h3= I18n.t(:production, :title)
        %p= I18n.t(:production, :body)
