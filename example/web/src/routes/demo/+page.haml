:ruby
  PageHeader = import("/components/PageHeader.haml")
  Panel = import("/components/Panel.haml")
  DemoScript = import("./demo.js")

%article
  %PageHeader{
    kicker: I18n.t(:header, :kicker),
    title: I18n.t(:header, :title),
    summary: I18n.t(:header, :summary)
  }
  %section
    %Panel{ title: I18n.t(:sections, :data, :title) }
      %p= I18n.t(:sections, :data, :body)
    %Panel{ title: I18n.t(:sections, :routing, :title) }
      %p= I18n.t(:sections, :routing, :body)
    %Panel{ title: I18n.t(:sections, :runtime, :title) }
      %p= I18n.t(:sections, :runtime, :body)
