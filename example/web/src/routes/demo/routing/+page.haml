:ruby
  PageHeader = import("/components/PageHeader.haml")
  SitemapPanel = import("./SitemapPanel.haml")
  RouteTreePanel = import("./RouteTreePanel.haml")
  SpecialViewsPanel = import("./SpecialViewsPanel.haml")
  Router = import("virtual:router")

  def initialize
    super

    @routes = Router::Default.routes
    @main_routes = @routes.reject(&:slot_layout_module_id).sort_by(&:path)
    @slot_routes = @routes.select(&:slot_layout_module_id).sort_by { [it.path, it.slot_layout_module_id.to_s] }
    @special_views = [*Router::Default.not_found_views, *Router::Default.error_views].sort_by { [it.path, it.kind.to_s] }
    @route_tree = route_tree_entries(Router::Default.tree)
  end

  def route_tree_entries(root)
    entries = []
    collect_route_tree_entries(root, entries)
    entries
  end

  def collect_route_tree_entries(node, entries, depth: 0, slot: nil)
    entries << { node:, depth:, slot: } unless node.root?

    node.children.sort_by(&:path).each do |child|
      slot_name = node.slots.key(child)
      collect_route_tree_entries(child, entries, depth: depth + 1, slot: slot_name || slot)
    end
  end

%article
  %PageHeader{
    kicker: "Routing",
    title: "Route sitemap",
    summary: "The generated router exposes enough metadata to inspect public routes, route modules, layouts, params, parallel slots, and error boundaries."
  }

  %SitemapPanel{ routes: @main_routes }
  %RouteTreePanel{ entries: @route_tree }
  %SpecialViewsPanel{ slot_routes: @slot_routes, special_views: @special_views }
