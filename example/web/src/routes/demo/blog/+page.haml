:ruby
  PageHeader = import("/components/PageHeader.haml")
  Posts = import_glob("./_posts/*.md").values.sort_by { |post| post::Frontmatter.fetch("date") }.reverse

%article
  %PageHeader{
    kicker: "Markdown content",
    title: "Blog posts loaded from Markdown files",
    summary: "This route imports Markdown posts and reads metadata from frontmatter."
  }
  %section
    = Posts.map do |post|
      - frontmatter = post::Frontmatter
      %article
        %header
          %h2= frontmatter.fetch("title")
          %time{ datetime: frontmatter.fetch("date") }= frontmatter.fetch("date")
        %p= frontmatter.fetch("summary")
        %a{ href: "/demo/blog/#{frontmatter.fetch("slug")}" } Read post
