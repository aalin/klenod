:ruby
  PageHeader = import("/components/PageHeader.haml")
  Panel = import("/components/Panel.haml")
  Posts = import_glob("../_posts/*.md").values

:ruby
  slug = request.params.fetch(:slug)
  post = Posts.find { |item| item::Frontmatter.fetch("slug") == slug }
  frontmatter = post && post::Frontmatter

%article
  = if post
    %PageHeader{
      kicker: "Dynamic Markdown route",
      title: frontmatter.fetch("title"),
      summary: frontmatter.fetch("summary")
    }
    %Panel{ title: "Post body" }
      %p
        %time{ datetime: frontmatter.fetch("date") }= frontmatter.fetch("date")
      = post.instantiate.render
      %p Ruby modules loaded through a dependency graph
  = else
    %PageHeader{
      kicker: "Dynamic Markdown route",
      title: "Blog post: #{slug}",
      summary: "No Markdown post exists for this slug, but the dynamic route still rendered."
    }
    %Panel{ title: "Missing post" }
      %p Ruby modules loaded through a dependency graph
