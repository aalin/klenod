:ruby
  Posts = import_glob("../_posts/*.md").values.sort_by { it::Frontmatter[:date] }.reverse

%article
  %aside
    %h2 Blog posts
    %nav(aria-label="Blog posts")
      = Posts.map do |post|
        - frontmatter = post::Frontmatter
        %a{ href: "/demo/blog/#{frontmatter[:slug]}" }= frontmatter[:title]
  %section
    = $children
