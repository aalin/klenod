:ruby
  Form = Example::Form
  Button = import("/components/Button.haml")
  PageHeader = import("/components/PageHeader.haml")
  Panel = import("/components/Panel.haml")

  def name
    @@request.session["name"]
  end

%article
  %PageHeader{
    kicker: "Runtime HTTP",
    title: "Session-backed form",
    summary: "This page exercises request parsing, encrypted cookies, scoped render context, redirects, and automatic CSRF fields."
  }
  %Panel{ title: "Encrypted session demo" }
    = if name
      %p= "Welcome back, #{name}."
    = else
      %p Submit the form to store your name in an encrypted session cookie.
    %Form{ method: "post", action: localized_path("/demo/forms/submit") }
      %label(for="name") Name
      %input(id="name" name="name" type="text" value=name required)
      %Button(type="submit") Save name
    = if name
      %Form{ method: "post", action: localized_path("/demo/forms/clear") }
        %Button(type="submit") Clear session
