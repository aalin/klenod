:ruby
  PageHeader = import("/components/PageHeader.haml")
  Panel = import("/components/Panel.haml")

  DEFAULT_DATE_STYLE = "long"
  DEFAULT_TIME_STYLE = "short"
  STYLE_VALUES = ["full", "long", "medium", "short", nil].freeze

  IntlTime = import("./IntlTime.tsx")
  TimeDemo = import("./TimeDemo.tsx")

%article
  %PageHeader{
    kicker: I18n.t(:header, :kicker),
    title: I18n.t(:header, :title),
    summary: I18n.t(:header, :summary)
  }

  %Panel{ title: I18n.t(:matrix, :title) }
    %table
      %thead
        %tr
          %th= I18n.t(:matrix, :date_style)
          %th= I18n.t(:matrix, :time_style)
          %th= I18n.t(:matrix, :output)
      %tbody
        = STYLE_VALUES.repeated_permutation(2).map do |date_style, time_style|
          %tr
            %td= date_style.inspect
            %td= time_style.inspect
            %td
              %IntlTime{
                lang: Example::Context.current&.request&.locale || "en",
                time: Time.now,
                "date-style": date_style || DEFAULT_DATE_STYLE,
                "time-style": time_style || DEFAULT_TIME_STYLE
              }= Time.now

  %Panel{ title: "TSX composition" }
    %TimeDemo{ time: Time.now }= Time.now
