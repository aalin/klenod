:ruby
  IntlTime = import("./IntlTime.tsx")

  DEFAULT_DATE_STYLE = "long"
  DEFAULT_TIME_STYLE = "short"

- time = $time || Time.now
- lang = $lang || Example::Framework::Context.current&.request&.locale || "en"
- date_style = prop(:date_style, DEFAULT_DATE_STYLE)
- time_style = prop(:time_style, DEFAULT_TIME_STYLE)
%IntlTime{
  lang:,
  time:,
  "date-style": date_style,
  "time-style": time_style,
}= time
