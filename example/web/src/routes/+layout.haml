:ruby
  Logo = import("./logo.svg")
  Homepage = Gem::Specification.find_by_name("klenod-runtime").homepage
  LanguageSwitcher = import("/components/LanguageSwitcher.haml")
  ThemeSwitcher = import("/components/ThemeSwitcher.haml")
  Links = [
    { href: "/", label: [:nav, :overview] },
    { href: "/docs", label: [:nav, :docs] },
    { href: "/demo", label: [:nav, :demo] }
  ]

%body
  %header
    .header-inner
      %a{ href: "/" }
        %img{ src: Logo.src, width: Logo.width, height: Logo.height, alt: "" }
        %span Klenod
        %span= I18n.t(:brand, :label)
      .header-actions
        %nav{ aria: { label: I18n.t(:nav, :label) } }
          = Links.map do |link|
            %a{ href: link[:href] }= I18n.t(*link[:label])
        %ThemeSwitcher
        %LanguageSwitcher
  %main
    = $children
  %footer
    .footer-inner
      .footer-copy
        %strong Klenod
        %span= I18n.t(:footer, :summary)
      .footer-links
        %a{ href: Homepage, target: "_blank", rel: "noreferrer" } GitHub
