        summary: "Filesystem routes, layouts, pages, handlers, not-found views, errors, route groups, and slots."
      }
      %DocsLinkCard{
        href: localized_path("/docs/plugins/GoogleFontsPlugin"),
        title: "GoogleFontsPlugin",
        summary: "Google Fonts CSS imports rewritten to local generated font assets."
      }
