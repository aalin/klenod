:ruby
  Link = Data.define(:href, :label)
  Section = Data.define(:label, :links) do
    def open?(current_path) = links.any? { it.href == current_path }
  end

  DocsSections = [
    Section[
      label: "Start",
      links: [
        Link["/docs", "Overview"],
        Link["/docs/getting-started", "Getting Started"],
        Link["/docs/core-concepts", "Core Concepts"],
        Link["/docs/configuration", "Configuration"],
      ]
    ],
    Section[
      label: "Guides",
      links: [
        Link["/docs/module-graph", "Module Graph"],
        Link["/docs/haml-components", "Haml Components"],
        Link["/docs/templates", "Markdown"],
        Link["/docs/assets", "Assets"],
        Link["/docs/data", "Data Imports"],
        Link["/docs/routing", "Routing"],
      ]
    ],
     Section[
      label: "Plugins",
      links: [
        Link["/docs/plugins", "Overview"],
        Link["/docs/plugins/RubyPlugin", "RubyPlugin"],
        Link["/docs/plugins/HamlPlugin", "HamlPlugin"],
        Link["/docs/plugins/MarkdownPlugin", "MarkdownPlugin"],
        Link["/docs/plugins/CssPlugin", "CssPlugin"],
        Link["/docs/plugins/RouterPlugin", "RouterPlugin"],
        Link["/docs/plugins/Assets", "Assets"],
        Link["/docs/plugins/DataPlugins", "Data Plugins"],
        Link["/docs/plugins/IntlPlugin", "IntlPlugin"],
        Link["/docs/plugins/GoogleFontsPlugin", "GoogleFontsPlugin"],
      ]
    ],
    Section[
      label: "Reference",
      links: [
        Link["/docs/development", "Development Updates"],
        Link["/docs/build-runtime", "Build And Runtime"],
      ]
    ]
  ].freeze

- current_path = request.canonical_path || request.path

.grid
  %aside
    %nav{ aria: { label: "Documentation" } }
      = DocsSections.map do |section|
        %details{ name: "docs-section", open: section.open?(current_path) }
          %summary= section.label
          = section.links.map do |link|
            %a{
              href: localized_path(link.href),
              "aria-current" => (current_path == link.href) ? "page" : nil
            }= link.label
  .content
    = $children
