:ruby
  Button = import("../components/Button.haml")
  PageHeader = import("../components/PageHeader.haml")
  Panel = import("../components/Panel.haml")
  I18n = Example::I18n.new(self)

%article
  %PageHeader{
    kicker: I18n.t(:header, :kicker),
    title: I18n.t(:header, :title),
    summary: I18n.t(:header, :summary)
  }
  %section
    %Panel{ title: I18n.t(:features, :transform, :title) }
      %p= I18n.t(:features, :transform, :body)
    %Panel{ title: I18n.t(:features, :assets, :title) }
      %p= I18n.t(:features, :assets, :body)
    %Panel{ title: I18n.t(:features, :bundle, :title) }
      %p= I18n.t(:features, :bundle, :body)
  %footer
    %Button{ href: localized_path("/demo") }= I18n.t(:actions, :demo)
    %Button{ href: localized_path("/demo/assets") }= I18n.t(:actions, :assets)
