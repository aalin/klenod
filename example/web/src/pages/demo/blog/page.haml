:ruby
  PageHeader = import("/components/PageHeader.haml")
  Posts = [
    import("./posts/graph.toml"),
    import("./posts/assets.toml"),
    import("./posts/routing.toml")
  ].sort_by { |post| post.fetch("date") }.reverse

%article
  %PageHeader{
    kicker: "TOML content",
    title: "Blog posts loaded from data files",
    summary: "This route imports a few TOML files and renders them as ordinary Ruby hashes."
  }
  %section
    = Posts.map do |post|
      %article
        %header
          %h2= post.fetch("title")
          %time{ datetime: post.fetch("date") }= post.fetch("date")
        %p= post.fetch("summary")
        %a{ href: localized_path("/demo/blog/[slug]", slug: post.fetch("slug")) } Read post
