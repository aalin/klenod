:ruby
  PageHeader = import("/components/PageHeader.haml")

  def initialize(...)
    @parts = request.params.fetch(:parts)
  end

%article
  %PageHeader{
    kicker: "Catch-all route",
    title: "Docs catch-all",
    summary: "Nested documentation paths are collected into a route parameter."
  }
  %p= "Path parts: #{@parts.join(" / ")}"
