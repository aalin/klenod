:ruby
  Form = Example::Form
  Button = import("/components/Button.haml")
  PageHeader = import("/components/PageHeader.haml")
  Panel = import("/components/Panel.haml")

  Locales = [
    ["en-US", "English"],
    ["sv-SE", "Svenska"]
  ]

%article
  %PageHeader{
    kicker: t("header.kicker"),
    title: t("header.title"),
    summary: t("header.summary")
  }

  %section
    %Panel{ title: t("current.title") }
      %dl
        %div
          %dt= t("current.requested")
          %dd= request.headers.fetch("accept-language", t("current.none"))
        %div
          %dt= t("current.resolved")
          %dd= I18n.resolve_locale(Translations)
        %div
          %dt= t("current.cookie")
          %dd= request.cookies.fetch(Example::LOCALE_COOKIE, t("current.none"))

    %Panel{ title: t("usage.title") }
      %p= t("usage.body")
      %pre
        %code= t("usage.code")

    %Panel{ title: t("examples.title") }
      %Form(method="post" action="/demo/translations/locale")
        = Locales.map do |locale, label|
          %label
            %input{ type: "radio", name: "locale", value: locale, checked: I18n.resolve_locale(Translations) == locale }
            %span= label
            %code= locale
        %Button(type="submit")= t("examples.submit")
