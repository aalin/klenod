:ruby
  LocaleFormPanel = import("./LocaleFormPanel.haml")
  PageHeader = import("/components/PageHeader.haml")
  Panel = import("/components/Panel.haml")
  I18n = Example::I18n.new(self, Translations)

  Locales = [
    ["en-US", "English"],
    ["sv-SE", "Svenska"]
  ]

%article{ lang: I18n.lang }
  %PageHeader{
    kicker: I18n.t(:header, :kicker),
    title: I18n.t(:header, :title),
    summary: I18n.t(:header, :summary)
  }

  %section
    %Panel{ title: I18n.t(:current, :title) }
      %dl
        %div
          %dt= I18n.t(:current, :requested)
          %dd= request.headers.fetch("accept-language", I18n.t(:current, :none))
        %div
          %dt= I18n.t(:current, :resolved)
          %dd= I18n.lang
        %div
          %dt= I18n.t(:current, :cookie)
          %dd= request.cookies.fetch(Example::LOCALE_COOKIE, I18n.t(:current, :none))

    %Panel{ title: I18n.t(:usage, :title) }
      %p= I18n.t(:usage, :body)
      %pre
        %code= I18n.t(:usage, :code)

    %LocaleFormPanel{ i18n: I18n, locales: Locales }
