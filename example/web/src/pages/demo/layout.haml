:ruby
  NavTabs = import("/components/NavTabs.haml")

  Links = [
    { href: "/demo", label: "Overview" },
    { href: "/demo/assets", label: "Assets" },
    { href: "/demo/forms", label: "Forms" },
    { href: "/demo/dashboard", label: "Dashboard" },
    { href: "/demo/blog", label: "Blog" },
    { href: "/demo/data", label: "Data imports" },
    { href: "/demo/translations", label: "Translations" },
    { href: "/demo/hybrid", label: "Hybrid route" },
    { href: "/demo/routing", label: "Routing" },
    { href: "/demo/blog/graph", label: "Dynamic params" },
    { href: "/demo/shop/sale/red", label: "Catch-all" }
  ]

  def initialize(children:, slots: {})
    @children = children
  end

%article
  %NavTabs{ links: Links.map { |link| link.merge(href: localized_path(link.fetch(:href))) } }
  %section
    = @children
