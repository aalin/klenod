:ruby
  PageHeader = import("/components/PageHeader.haml")
  Panel = import("/components/Panel.haml")
  Filters = [
    { slug: "sale", label: "Sale" },
    { slug: "red", label: "Red" },
    { slug: "sailing", label: "Sailing" },
    { slug: "coffee", label: "Coffee" }
  ]

  def enabled?(filter, filters)
    filters.include?(filter.fetch(:slug))
  end

  def href_for(filter, filters)
    slug = filter.fetch(:slug)
    selected =
      if enabled?(filter, filters)
        filters - [slug]
      else
        filters + [slug]
      end
    next_filters = Filters.map { it.fetch(:slug) } & selected

    ["/demo/shop", *next_filters].join("/")
  end

:ruby
  filters = request.params.fetch(:filters)

%article
  %PageHeader{
    kicker: "Optional catch-all route",
    title: "Shop filters",
    summary: "Optional catch-all segments can match the base route or any number of nested filter parts."
  }
  %Panel{ title: "Available filters" }
    %nav{ class: Styles[:filters], aria: { label: "Shop filters" } }
      = Filters.map do |filter|
        %a{
          class: [Styles[:filter], enabled?(filter, filters) ? Styles[:enabled] : nil],
          href: href_for(filter, filters),
          aria: { pressed: enabled?(filter, filters).to_s }
        }= filter.fetch(:label)
    %p{ class: Styles[:summary] }
      = if filters.empty?
        No filters selected
      = else
        = "Filters: #{filters.join(", ")}"
