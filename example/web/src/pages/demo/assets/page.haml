:ruby
  Figure = import("/components/Figure.haml")
  PageHeader = import("/components/PageHeader.haml")
  Panel = import("/components/Panel.haml")

  Items = [
    {
      name: "coffee.jpg",
      image: import("./coffee.jpg"),
      alt: "Coffee cup on a table",
      caption: "Default import"
    },
    {
      name: "coffee.jpg",
      image: import("./coffee.jpg?width=240,360,720,960"),
      alt: "Coffee cup on a table",
      caption: "Imported with configured widths"
    },
    {
      name: "coffee.jpg",
      image: import("./coffee.jpg?width=360,720&format=webp"),
      alt: "Coffee cup on a table",
      caption: "Imported as webp."
    },
    {
      name: "sailing-boat.jpg",
      image: import("./sailing-boat.jpg?width=360,720&format=jpeg"),
      alt: "Sailing boat on open water",
      caption: "A sailing image with generated JPEG widths."
    },
    {
      name: "vegetables.jpg",
      image: import("./vegetables.jpg?width=360,720&format=jpeg"),
      alt: "Vegetables arranged for cooking",
      caption: "Vegetables rendered through the shared Figure component."
    }
  ]

  def image_rows(image)
    [
      ["src", image.src],
      ["width", image.width],
      ["height", image.height],
      ["sizes", image.sizes],
      ["srcset", image.srcset]
    ]
  end

%article
  %PageHeader{
    kicker: "Assets",
    title: "Images become generated browser assets",
    summary: "Assets are imported through routed Haml pages and emitted with generated variants for responsive image markup."
  }
  %section
    = Items.map do |item|
      %Panel
        %Figure{ image: item[:image], alt: item[:alt], caption: item[:caption] }
        %div.metadata
          %h2= item[:name]
          %dl
            = image_rows(item[:image]).map do |label, value|
              %dt= label
              %dd
                %code= value
          %h3 Variants
          %ol
            = item[:image].variants.map do |variant|
              %li
                %span.variant-label
                  %strong= variant.descriptor
                  %span= "#{variant.width} x #{variant.height} #{variant.format}"
                %a(href="#{variant.src}" target="_blank")= variant.src
  %Panel{ title: "CSS url()" }
    %div.css-image
    %p CSS can reference image files with `url("./coffee.jpg")`; the CSS plugin rewrites the URL to the generated asset path.
