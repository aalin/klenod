:ruby
  def initialize(children:, slots: {})
    @children = children
    @slots = slots
  end

%article
  = if @slots[:sidebar]
    %nav
      = @slots[:sidebar]
  %section
    = @children
  = if @slots[:modal]
    %button(type="button" commandfor="dashboard-modal" command="show-modal") Open dispatch notice
    %dialog(id="dashboard-modal")
      = @slots[:modal]
      %footer
        %button(type="button" commandfor="dashboard-modal" command="close") Close
