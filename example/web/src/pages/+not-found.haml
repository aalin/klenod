:ruby
  PageHeader = import("../components/PageHeader.haml")
  Panel = import("../components/Panel.haml")

  def initialize(path:, status:)
    @path = path
    @status = status
  end

%article
  %PageHeader{
    kicker: @status.to_s,
    title: "Page not found",
    summary: "No route matched #{@path}."
  }
  %section
    %Panel{ title: "Try another route" }
      %p The example app could not find a page or route handler for this URL.
      %p
        %a{ href: "/demo" } Browse the demo routes
