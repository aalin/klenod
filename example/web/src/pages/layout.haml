:ruby
  Links = [
    { href: "/", label: "Overview" },
    { href: "/demo", label: "Demo" }
  ]

  def initialize(children:, slots: {})
    @children = children
    @slots = slots
  end

%body
  %header
    %a{ href: "/" }
      %span Klenod
      %span example
    %nav(aria-label="Primary")
      = Links.map do |link|
        %a{ href: link.fetch(:href) }= link.fetch(:label)
  %main
    = @children
