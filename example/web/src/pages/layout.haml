:ruby
  LanguageSwitcher = import("/components/LanguageSwitcher.haml")
  Links = [
    { href: "/", label: "Overview" },
    { href: "/demo", label: "Demo" }
  ]

  def initialize(children:, slots: {})
    @children = children
    @slots = slots
  end

%body
  %header
    %a{ href: localized_path("/") }
      %span Klenod
      %span example
    .header-actions
      %nav(aria-label="Primary")
        = Links.map do |link|
          %a{ href: localized_path(link.fetch(:href)) }= link.fetch(:label)
      %LanguageSwitcher
  %main
    = @children
