:ruby
  DocsLinks = [
    {href: "/docs", label: "Overview"},
    {href: "/docs/core-concepts", label: "Core Concepts"},
    {href: "/docs/getting-started", label: "Getting Started"},
    {href: "/docs/configuration", label: "Configuration"},
    {href: "/docs/module-graph", label: "Module Graph"},
    {href: "/docs/haml-css", label: "Haml And CSS"},
    {href: "/docs/assets", label: "Assets"},
    {href: "/docs/templates", label: "Markdown"},
    {href: "/docs/routing", label: "Router Plugin"},
    {href: "/docs/data", label: "Data Imports"},
    {href: "/docs/development", label: "Development Updates"},
    {href: "/docs/build-runtime", label: "Build And Runtime"},
    {href: "/docs/plugins", label: "Plugin Reference"}
  ].freeze

  def initialize(children:, slots: {})
    @children = children
    @current_path = request.canonical_path || request.path
  end

.docs-shell
  %aside
    %p Docs
    %nav{ aria: { label: "Documentation" } }
      = DocsLinks.map do |link|
        %a{
          href: localized_path(link.fetch(:href)),
          "aria-current" => (@current_path == link.fetch(:href)) ? "page" : nil
        }= link.fetch(:label)
  .docs-content
    = @children
