:ruby
  DocsSections = [
    {
      label: "Start",
      links: [
        {href: "/docs", label: "Overview"},
        {href: "/docs/getting-started", label: "Getting Started"},
        {href: "/docs/core-concepts", label: "Core Concepts"},
        {href: "/docs/configuration", label: "Configuration"}
      ]
    },
    {
      label: "Guides",
      links: [
        {href: "/docs/module-graph", label: "Module Graph"},
        {href: "/docs/haml-components", label: "Haml Components"},
        {href: "/docs/templates", label: "Markdown"},
        {href: "/docs/assets", label: "Assets"},
        {href: "/docs/data", label: "Data Imports"},
        {href: "/docs/routing", label: "Routing"}
      ]
    },
    {
      label: "Plugins",
      links: [
        {href: "/docs/plugins", label: "Overview"},
        {href: "/docs/plugins/RubyPlugin", label: "RubyPlugin"},
        {href: "/docs/plugins/HamlPlugin", label: "HamlPlugin"},
        {href: "/docs/plugins/MarkdownPlugin", label: "MarkdownPlugin"},
        {href: "/docs/plugins/CssPlugin", label: "CssPlugin"},
        {href: "/docs/plugins/RouterPlugin", label: "RouterPlugin"},
        {href: "/docs/plugins/Assets", label: "Assets"},
        {href: "/docs/plugins/DataPlugins", label: "Data Plugins"},
        {href: "/docs/plugins/IntlPlugin", label: "IntlPlugin"},
        {href: "/docs/plugins/GoogleFontsPlugin", label: "GoogleFontsPlugin"}
      ]
    },
    {
      label: "Reference",
      links: [
        {href: "/docs/development", label: "Development Updates"},
        {href: "/docs/build-runtime", label: "Build And Runtime"}
      ]
    }
  ].freeze

  def section_open?(section, current_path)
    section.fetch(:links).any? { |link| link.fetch(:href) == current_path }
  end

- current_path = request.canonical_path || request.path

.docs-shell
  %aside
    %nav{ aria: { label: "Documentation" } }
      = DocsSections.map do |section|
        %details{ name: "docs-section", open: section_open?(section, current_path) }
          %summary= section.fetch(:label)
          = section.fetch(:links).map do |link|
            %a{
              href: localized_path(link.fetch(:href)),
              "aria-current" => (current_path == link.fetch(:href)) ? "page" : nil
            }= link.fetch(:label)
  .docs-content
    = $children
