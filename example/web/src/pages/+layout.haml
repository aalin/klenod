:ruby
  I18n = Example::I18n.new(self)
  LanguageSwitcher = import("/components/LanguageSwitcher.haml")
  Links = [
    { href: "/", label: [:nav, :overview] },
    { href: "/demo", label: [:nav, :demo] }
  ]

  def initialize(children:, slots: {})
    @children = children
    @slots = slots
  end

%body
  %header
    .header-inner
      %a{ href: localized_path("/") }
        %span Klenod
        %span= I18n.t(:brand, :label)
      .header-actions
        %nav{ aria: { label: I18n.t(:nav, :label) } }
          = Links.map do |link|
            %a{ href: localized_path(link[:href]) }= I18n.t(*link[:label])
        %LanguageSwitcher
  %main
    = @children
