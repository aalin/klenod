:ruby
  Button = import("../components/Button.haml")
  PageHeader = import("../components/PageHeader.haml")
  Panel = import("../components/Panel.haml")

%article
  %PageHeader{
    kicker: "Overview",
    title: "Build Ruby modules like a modern frontend graph",
    summary: "Klenod loads Ruby, Haml, CSS, data files, and assets through one dependency graph with development reloading and production bundles."
  }
  %section
    %Panel{ title: "Transform source files" }
      %p Haml components become Ruby classes, CSS selectors are scoped, and imports become dependency records.
    %Panel{ title: "Emit browser assets" }
      %p Images and stylesheets are generated from imports while Ruby modules receive stable runtime values.
    %Panel{ title: "Bundle for runtime" }
      %p The collected graph can be serialized with Marshal and loaded later without build plugins.
  %footer
    %Button(href="/demo") Explore demos
    %Button(href="/demo/assets") View assets
